---
import { MAPA_COLLINS, rutas, ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].jams;
const l = lang === "es" ? { cuando: "Cuándo", donde: "Dónde" } : { cuando: "When", donde: "Where" };
---

<h1 class="titulo registro" data-texto={t.titulo}>{t.titulo}</h1>
<p class="subtitulo">{t.subtitulo}</p>
<div class="fichas">
  <article class="ficha jam">
    <div class="logo-jam"><img src={`${import.meta.env.BASE_URL}ilustraciones/americana-music-jam-madrid.webp`} alt="" width="700" height="634" /></div>
    <h3>{t.collins.nombre}</h3>
    <p>{t.collins.texto}</p>
    <dl>
      <dt>{l.cuando}</dt><dd>{t.collins.cuando}</dd>
      <dt>{l.donde}</dt><dd>{t.collins.donde}</dd>
    </dl>
    <a class="ir llegar" href={MAPA_COLLINS} target="_blank" rel="noopener"><span class="ilus ilus-rosa" aria-hidden="true"></span>{t.llegar}</a>
  </article>
  <article class="ficha jam">
    <div class="logo-jam"><img src={`${import.meta.env.BASE_URL}ilustraciones/slow-jam-madrid.webp`} alt="" width="483" height="326" /></div>
    <h3>{t.slow.nombre}</h3>
    <p>{t.slow.texto}</p>
    <dl>
      <dt>{l.cuando}</dt><dd><a href={rutas.agenda[lang]}>{t.slow.cuando}</a></dd>
    </dl>
  </article>
</div>
