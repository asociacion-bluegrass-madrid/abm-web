---
import Sitio from "../../../layouts/Sitio.astro";
import Seccion from "../../../secciones/Noticia.astro";
import { noticias, paginaNoticia, type Noticia } from "../../../noticias";

export async function getStaticPaths() {
  return (await noticias("en")).map((noticia) => ({ params: { slug: noticia.slug }, props: { noticia } }));
}
const { noticia } = Astro.props as { noticia: Noticia };
const pagina = await paginaNoticia(noticia);
---

<Sitio lang="en" pestana="noticias" pagina={pagina}><Seccion lang="en" noticia={noticia} /></Sitio>
