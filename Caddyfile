# Railway serves the site with Caddy (Railpack picks this file up instead of its default).
# Same as Railpack's default Caddyfile, plus explicit cache headers: without them browsers kept old pages.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Hashed build files change name when they change, so they can be kept for good.
	# Everything else (pages, photos, textures) is checked with the server on each visit.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@resto not path /_astro/*
	header @resto Cache-Control "no-cache"

	root * {$SITE_ROOT:/app/dist}

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html /index.html
}
